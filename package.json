{
  "name": "dbx-waitwork",
  "version": "0.6.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Wait Work：等一会工作，休息一下。DBX 本地与在线小说阅读插件。",
  "scripts": {
    "build": "vite build",
    "dev:ui": "vite",
    "dev": "npm run build && node scripts/dev.mjs",
    "preview": "npm run build && npm run build:backend && node scripts/preview.mjs",
    "package": "npm run build && dbx-plugin package .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && npm run build:backend && playwright test",
    "build:backend": "node scripts/build-backend.mjs",
    "test:backend": "go -C backend test ./...",
    "release:check": "node scripts/release.mjs check",
    "release:collect": "node scripts/release.mjs collect dist/release"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@dbx-app/plugin-cli": "0.1.9",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.16.0",
    "fflate": "0.8.3",
    "foliate-js": "https://github.com/johnfactotum/foliate-js/archive/78914aef4466eb960965702401634c2cb348e9b1.tar.gz",
    "vue": "3.5.42"
  }
}
